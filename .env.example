# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO COM O SUPABASE POSTGRESQL
# ==============================================================================
# Obtenha os dados no painel do Supabase:
# Acesse seu projeto -> Project Settings -> Database -> Connection string -> URI
# (ou clique em "Connect" no topo do painel do Supabase).

# Opção 1: Conexão Direta (porta 5432):
DATABASE_URL=postgresql://postgres:SENHA@db.DATABASE_ID.supabase.co:5432/postgres

# Opção 2: Conexão via Connection Pooler (porta 6543 ou 5432):
# DATABASE_URL=postgresql://postgres.DATABASE_ID:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

